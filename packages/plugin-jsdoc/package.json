{
    "name": "@ng-prism/plugin-jsdoc",
    "version": "22.8.0",
    "description": "JSDoc API documentation panel for ng-prism.",
    "ng-add": {
        "save": "devDependencies"
    },
    "schematics": "./schematics/collection.json",
    "keywords": [
        "@ng-prism/core",
        "jsdoc",
        "api",
        "documentation",
        "plugin",
        "angular",
        "styleguide"
    ],
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "browser": "./dist/index.browser.js",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "schematics",
        "!**/*.tsbuildinfo"
    ],
    "peerDependencies": {
        "@angular/common": ">=20.0.0",
        "@angular/core": ">=20.0.0",
        "@ng-prism/core": "^22.8.0-0",
        "highlight.js": ">=11.0.0",
        "ngx-highlightjs": ">=14.0.0",
        "typescript": ">=5.5.0",
        "@angular-devkit/schematics": ">=20.0.0",
        "@angular/platform-browser": ">=20.0.0"
    },
    "devDependencies": {
        "@ng-prism/core": "*"
    },
    "dependencies": {
        "marked": "^15.0.12",
        "tslib": "^2.3.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ng-prism/ng-prism.git",
        "directory": "packages/plugin-jsdoc"
    },
    "homepage": "https://ng-prism.github.io/ng-prism/",
    "bugs": "https://github.com/ng-prism/ng-prism/issues"
}
