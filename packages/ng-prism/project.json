{
    "name": "ng-prism",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node_modules/.bin/ngc --project packages/ng-prism/tsconfig.lib.json"
            },
            "inputs": ["production", "^production"],
            "outputs": ["{projectRoot}/dist"]
        },
        "test": {
            "dependsOn": ["^build", "plugin-jsdoc:build"]
        },
        "test-chromium": {
            "executor": "@nx/jest:jest",
            "options": {
                "jestConfig": "packages/ng-prism/jest.chromium.config.cjs"
            },
            "inputs": ["default", "^default", { "runtime": "node -p process.platform" }],
            "cache": true
        }
    }
}
